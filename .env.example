# Build-time pipeline keys (all optional; fetchers skip gracefully when missing)
USDA_LFP_API_KEY=
MARS_API_KEY=
NASS_API_KEY=
CENSUS_API_KEY=
# Frontend
VITE_BACKEND=demo
# Public browser configuration for account authentication (independent of VITE_BACKEND).
# Copy to .env.local and restart Vite after changing values.
# Use the project's publishable key only; never use secret or service-role keys here.
# Paste the complete project root URL exactly once (no dashboard URL or /auth/v1 path).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
